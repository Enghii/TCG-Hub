# URL do proxy seguro do TCG Hub, criado após a Riot aprovar o aplicativo.
# A chave Riot permanece somente no servidor e nunca é incluída no app mobile.
EXPO_PUBLIC_RIFTBOUND_CATALOG_URL=

# Valores públicos do projeto Supabase. Nunca use a service_role no aplicativo.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
